{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Design tokens for LUMORA (light mode) - Luxury Architecture & Interior Design",
  "color": {
    "warm-ivory": {
      "$value": "#F5F2EC",
      "$type": "color"
    },
    "soft-limestone": {
      "$value": "#DCD5C9",
      "$type": "color"
    },
    "charcoal": {
      "$value": "#252521",
      "$type": "color"
    },
    "deep-olive": {
      "$value": "#555B48",
      "$type": "color"
    },
    "muted-bronze": {
      "$value": "#A68D69",
      "$type": "color"
    },
    "pure-white": {
      "$value": "#FFFFFF",
      "$type": "color"
    }
  },
  "font": {
    "heading": {
      "$value": "Cormorant Garamond, serif",
      "$type": "fontFamily"
    },
    "body": {
      "$value": "DM Sans, sans-serif",
      "$type": "fontFamily"
    }
  },
  "semantic": {
    "color": {
      "primary": {
        "$value": "{color.charcoal}",
        "$type": "color"
      },
      "on-primary": {
        "$value": "{color.pure-white}",
        "$type": "color"
      },
      "secondary": {
        "$value": "{color.deep-olive}",
        "$type": "color"
      },
      "on-secondary": {
        "$value": "{color.pure-white}",
        "$type": "color"
      },
      "accent": {
        "$value": "{color.muted-bronze}",
        "$type": "color"
      },
      "on-accent": {
        "$value": "{color.charcoal}",
        "$type": "color"
      },
      "background": {
        "$value": "{color.warm-ivory}",
        "$type": "color"
      },
      "foreground": {
        "$value": "{color.charcoal}",
        "$type": "color"
      },
      "card": {
        "$value": "{color.pure-white}",
        "$type": "color"
      },
      "card-foreground": {
        "$value": "{color.charcoal}",
        "$type": "color"
      },
      "muted": {
        "$value": "{color.soft-limestone}",
        "$type": "color"
      },
      "muted-foreground": {
        "$value": "{color.deep-olive}",
        "$type": "color"
      },
      "border": {
        "$value": "{color.soft-limestone}",
        "$type": "color"
      },
      "destructive": {
        "$value": "#C0392B",
        "$type": "color"
      },
      "on-destructive": {
        "$value": "{color.pure-white}",
        "$type": "color"
      },
      "ring": {
        "$value": "{color.muted-bronze}",
        "$type": "color"
      }
    },
    "font": {
      "heading": {
        "$value": "{font.heading}",
        "$type": "fontFamily"
      },
      "body": {
        "$value": "{font.body}",
        "$type": "fontFamily"
      }
    }
  }
}